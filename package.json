{
  "name": "t-helper",
  "version": "1.2.0",
  "private": true,
  "description": "Desktop helper for T-Bank support operators",
  "author": "whxtelxs",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tauri": "tauri",
    "test": "vitest run",
    "format:check": "prettier --check src tests index.html package.json tsconfig*.json *.config.* .github/workflows",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "motion": "^13.1.1",
    "preact": "^10.29.8",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.11.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/semver": "^7.8.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  }
}
